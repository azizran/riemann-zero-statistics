 "script": "# Exact E sum_n M_n^2 = 2*pi*F_N(1/2,1) via Winn (CMP 2012) Thm 2.2 with k=1, h=1/2 (no zeta data)\nfrom fractions import Fraction as Fr\nfrom math import factorial as f, e, pi\ndef CN(p,N):  # C_N(p,1) = 2^p N!/((N-p)! (p+1)! p!)\n    return Fr(2**p*f(N), f(N-p)*f(p+1)*f(p))\ndef S(N):     # pi*F_N(1/2,1)/(N+1) = N - sum_{p=2}^N (p-2)! C_N(p,1)/N^{p-1}\n    return CN(1,N) - sum(Fr(f(p-2),N**(p-1))*CN(p,N) for p in range(2,N+1))\nfor N in (2,3,4,6,10,16,24,32,64,128,1000):\n    tot=2*(N+1)*S(N)   # = 2*pi*F_N(1/2,1) = E sum_n M_n^2\n    print(N, float(tot/N**2), (str(tot) if N<=6 else ''))\nprint('(e^2-5)/2 =', (e**2-5)/2)\n"
}